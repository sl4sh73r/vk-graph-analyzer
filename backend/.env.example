# VK OAuth App credentials (create at id.vk.com)
VK_APP_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:5173/auth/callback
# Backend HTTP port
PORT=4000
# Allowed CORS origin (e.g., http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
# Session secret for storing user tokens
SESSION_SECRET=your-random-secret-key-here
# VK Service Key (optional, for fallback API access)
VK_SERVICE_KEY=
# VK Initial cooldown (seconds) before first friends.get if no cache
# Recommended: 60-90 if you get Flood control immediately after auth
VK_INITIAL_COOLDOWN_SEC=0
